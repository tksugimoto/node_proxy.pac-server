{
	"manifest_version": 3,
	"name": "PAC URL Switcher",
	"version": "1.0.0",
	"description": "proxy.pac の URL を設定してブラウザのプロキシに適用する",
	"permissions": [
		"proxy",
		"storage"
	],
	"action": {
		"default_title": "PAC URL Switcher"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "background.js"
	}
}
